MONGO_URI=mongodb://localhost:27017/auramarket

# JWT Authentication Secret Key & Expiration
JWT_SECRET=auramarket_super_secret_jwt_key_2026_xyz987
JWT_EXPIRE=30d

# Platform Settings
STORE_NAME=AuraMarket
SUPPORT_EMAIL=support@auramarket.com
